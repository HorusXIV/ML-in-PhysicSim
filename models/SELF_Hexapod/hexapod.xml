<mujoco model="hexapod_3dof">
    <compiler angle="degree" coordinate="local"/>
    <option integrator="implicitfast" timestep="0.002" iterations="1"/>

    <default>
        <geom rgba="0.1 0.5 0.8 1" type="capsule" density="1000" size="0.015"/>
        <joint type="hinge" limited="true" armature="0.01" damping="0.5"/>
        <position kp="25" kv="1.5"/>
    </default>

    <asset>
        <mesh name="hexagon_mesh" vertex="0.2425 0.14 0.04 0.0 0.28 0.04 -0.2425 0.14 0.04 -0.2425 -0.14 0.04 0.0 -0.28 0.04 0.2425 -0.14 0.04 0.2425 0.14 -0.04 0.0 0.28 -0.04 -0.2425 0.14 -0.04 -0.2425 -0.14 -0.04 0.0 -0.28 -0.04 0.2425 -0.14 -0.04"/>
    </asset>

    <worldbody>
        <body name="torso" pos="0 0 0.35">
            <freejoint name="root"/>
            <geom name="torso_geom" type="mesh" mesh="hexagon_mesh" density="250" rgba="0.25 0.25 0.28 1"/>

            <!-- Leg generation pattern. FL: 30, ML: 90, BL: 150, FR: -30, MR: -90, BR: -150 -->
            <!-- Front Left (+30 deg) -->
            <body name="coxa_fl" pos="0.2425 0.14 0" euler="0 0 30">
                <joint name="joint_coxa_fl" axis="0 0 1" range="-35 35"/>
                <geom name="geom_coxa_fl" fromto="0 0 0 0.05 0 0"/>
                <body name="femur_fl" pos="0.05 0 0">
                    <joint name="joint_femur_fl" axis="0 1 0" range="-60 40"/>
                    <geom name="geom_femur_fl" fromto="0 0 0 0.12 0 0" rgba="0.8 0.3 0.1 1"/>
                    <body name="tibia_fl" pos="0.12 0 0">
                        <joint name="joint_tibia_fl" axis="0 1 0" range="-40 60"/>
                        <geom name="geom_tibia_fl" fromto="0 0 0 0 0 -0.22" rgba="0.2 0.8 0.3 1"/>
                    </body>
                </body>
            </body>

            <!-- Mid Left (+90 deg) -->
            <body name="coxa_ml" pos="0 0.28 0" euler="0 0 90">
                <joint name="joint_coxa_ml" axis="0 0 1" range="-35 35"/>
                <geom name="geom_coxa_ml" fromto="0 0 0 0.05 0 0"/>
                <body name="femur_ml" pos="0.05 0 0">
                    <joint name="joint_femur_ml" axis="0 1 0" range="-60 40"/>
                    <geom name="geom_femur_ml" fromto="0 0 0 0.12 0 0" rgba="0.8 0.3 0.1 1"/>
                    <body name="tibia_ml" pos="0.12 0 0">
                        <joint name="joint_tibia_ml" axis="0 1 0" range="-40 60"/>
                        <geom name="geom_tibia_ml" fromto="0 0 0 0 0 -0.22" rgba="0.2 0.8 0.3 1"/>
                    </body>
                </body>
            </body>

            <!-- Back Left (+150 deg) -->
            <body name="coxa_bl" pos="-0.2425 0.14 0" euler="0 0 150">
                <joint name="joint_coxa_bl" axis="0 0 1" range="-35 35"/>
                <geom name="geom_coxa_bl" fromto="0 0 0 0.05 0 0"/>
                <body name="femur_bl" pos="0.05 0 0">
                    <joint name="joint_femur_bl" axis="0 1 0" range="-60 40"/>
                    <geom name="geom_femur_bl" fromto="0 0 0 0.12 0 0" rgba="0.8 0.3 0.1 1"/>
                    <body name="tibia_bl" pos="0.12 0 0">
                        <joint name="joint_tibia_bl" axis="0 1 0" range="-40 60"/>
                        <geom name="geom_tibia_bl" fromto="0 0 0 0 0 -0.22" rgba="0.2 0.8 0.3 1"/>
                    </body>
                </body>
            </body>

            <!-- Front Right (-30 deg) -->
            <body name="coxa_fr" pos="0.2425 -0.14 0" euler="0 0 -30">
                <joint name="joint_coxa_fr" axis="0 0 1" range="-35 35"/>
                <geom name="geom_coxa_fr" fromto="0 0 0 0.05 0 0"/>
                <body name="femur_fr" pos="0.05 0 0">
                    <joint name="joint_femur_fr" axis="0 1 0" range="-60 40"/>
                    <geom name="geom_femur_fr" fromto="0 0 0 0.12 0 0" rgba="0.8 0.3 0.1 1"/>
                    <body name="tibia_fr" pos="0.12 0 0">
                        <joint name="joint_tibia_fr" axis="0 1 0" range="-40 60"/>
                        <geom name="geom_tibia_fr" fromto="0 0 0 0 0 -0.22" rgba="0.2 0.8 0.3 1"/>
                    </body>
                </body>
            </body>

            <!-- Mid Right (-90 deg) -->
            <body name="coxa_mr" pos="0 -0.28 0" euler="0 0 -90">
                <joint name="joint_coxa_mr" axis="0 0 1" range="-35 35"/>
                <geom name="geom_coxa_mr" fromto="0 0 0 0.05 0 0"/>
                <body name="femur_mr" pos="0.05 0 0">
                    <joint name="joint_femur_mr" axis="0 1 0" range="-60 40"/>
                    <geom name="geom_femur_mr" fromto="0 0 0 0.12 0 0" rgba="0.8 0.3 0.1 1"/>
                    <body name="tibia_mr" pos="0.12 0 0">
                        <joint name="joint_tibia_mr" axis="0 1 0" range="-40 60"/>
                        <geom name="geom_tibia_mr" fromto="0 0 0 0 0 -0.22" rgba="0.2 0.8 0.3 1"/>
                    </body>
                </body>
            </body>

            <!-- Back Right (-150 deg) -->
            <body name="coxa_br" pos="-0.2425 -0.14 0" euler="0 0 -150">
                <joint name="joint_coxa_br" axis="0 0 1" range="-35 35"/>
                <geom name="geom_coxa_br" fromto="0 0 0 0.05 0 0"/>
                <body name="femur_br" pos="0.05 0 0">
                    <joint name="joint_femur_br" axis="0 1 0" range="-60 40"/>
                    <geom name="geom_femur_br" fromto="0 0 0 0.12 0 0" rgba="0.8 0.3 0.1 1"/>
                    <body name="tibia_br" pos="0.12 0 0">
                        <joint name="joint_tibia_br" axis="0 1 0" range="-40 60"/>
                        <geom name="geom_tibia_br" fromto="0 0 0 0 0 -0.22" rgba="0.2 0.8 0.3 1"/>
                    </body>
                </body>
            </body>

            <camera name="tracking_cam" pos="0 -1.6 0.8" euler="60 0 0" mode="track"/>
        </body>
    </worldbody>

    <actuator>
        <position name="act_coxa_fl" joint="joint_coxa_fl"/>
        <position name="act_femur_fl" joint="joint_femur_fl"/>
        <position name="act_tibia_fl" joint="joint_tibia_fl"/>
        
        <position name="act_coxa_ml" joint="joint_coxa_ml"/>
        <position name="act_femur_ml" joint="joint_femur_ml"/>
        <position name="act_tibia_ml" joint="joint_tibia_ml"/>
        
        <position name="act_coxa_bl" joint="joint_coxa_bl"/>
        <position name="act_femur_bl" joint="joint_femur_bl"/>
        <position name="act_tibia_bl" joint="joint_tibia_bl"/>
        
        <position name="act_coxa_fr" joint="joint_coxa_fr"/>
        <position name="act_femur_fr" joint="joint_femur_fr"/>
        <position name="act_tibia_fr" joint="joint_tibia_fr"/>
        
        <position name="act_coxa_mr" joint="joint_coxa_mr"/>
        <position name="act_femur_mr" joint="joint_femur_mr"/>
        <position name="act_tibia_mr" joint="joint_tibia_mr"/>
        
        <position name="act_coxa_br" joint="joint_coxa_br"/>
        <position name="act_femur_br" joint="joint_femur_br"/>
        <position name="act_tibia_br" joint="joint_tibia_br"/>
    </actuator>
</mujoco>
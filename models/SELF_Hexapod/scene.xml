<mujoco model="hexapod hand scene">
  <include file="hexapod.xml"/>

  <statistic center="0 0 0.15" extent="1.0"/>

  <visual>
    <headlight ambient=".3 .3 .3" diffuse=".6 .6 .6" specular="0 0 0"/>
    <map znear=".01"/>
    <scale forcewidth=".01" contactwidth=".06" contactheight=".01" jointwidth=".01" framelength=".3" framewidth=".01"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <quality shadowsize="8192"/>
    <global azimuth="-90" elevation="-20" offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <!-- 2. Keep the worldbody clean, containing only environmental objects -->
  <worldbody>
    <!--fixed camera for visualization -->
    <camera name="fixed_cam" pos="0 -1.5 1.0" euler="60 0 0"/>
    <camera name="top_cam" pos="0 0 2.0" euler="0 0 0"/>
    <light pos="0 0 1.5" dir="0 0 -1"/>
    <geom name="floor" pos="0 0 -0.1" size="0 0 0.05" type="plane" material="groundplane" friction="1.5 0.005 0.0001"/>
  </worldbody>
</mujoco>
